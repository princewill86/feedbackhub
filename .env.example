# Local PostgreSQL connection used by the app and Drizzle.
DATABASE_URL=postgres://feedbackhub:feedbackhub@127.0.0.1:5432/feedbackhub
# Replace with output from openssl rand -hex 32.
BETTER_AUTH_SECRET=
# Canonical web origin used by Better Auth and the Node adapter.
BETTER_AUTH_URL=http://localhost:5173
ORIGIN=http://localhost:5173

# Choose resend, smtp, or php. Omit the credentials and sender for local development.
MAIL_TRANSPORT=resend
# Sender address. SMTP and PHP require a bare address.
MAIL_FROM=
# Required for the Resend transport.
RESEND_API_KEY=

# SMTP submission server. Set SMTP_TLS to starttls or implicit.
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# PHP CLI path. The host must configure PHP mail() and its local mail transfer agent.
PHP_MAIL_BINARY=php

# Set false on web replicas that should leave queue processing to another replica.
MAIL_WORKER_ENABLED=true

# Whitespace-separated, exact HTTPS webhook destinations under operator control.
WEBHOOK_ALLOWED_URLS=

# Optional Stripe hosted checkout, customer portal, and subscription webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paystack prepaid checkout. The dedicated webhook signing secret is optional for legacy signatures.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Optional BTCPay Greenfield store for Bitcoin prepaid invoices.
BTCPAY_ORIGIN=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

# Optional NOWPayments credentials. Set true to use the provider sandbox.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false
